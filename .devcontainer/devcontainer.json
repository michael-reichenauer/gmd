{
	"name": "C# (.NET)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:11.0",
	// The GitHub CLI, installed with the image at every rebuild, so that the CI runs can be read from
	// here (gh run view <id> --log-failed) without a step by hand. Its login is kept in a volume, see
	// mounts below, so 'gh auth login' is needed once, not after every rebuild.
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"ms-dotnettools.csharp",
				"csharpier.csharpier-vscode",
				"mhutchie.git-graph",
				"streetsidesoftware.code-spell-checker"
			]
		}
	},
	// Keep Claude Code's state — settings, session history, plans and memory — across container
	// rebuilds. Only /workspaces is a real volume; everything else, including /home/vscode, lives on
	// the container's overlay layer and is wiped when the container is rebuilt.
	// Note this persists Claude's *state*, not the CLI itself: the binary installs to
	// ~/.local/share/claude, so scripts/installtools is still needed after a rebuild (as it is for tmux,
	// mc and lnav anyway).
	// The GitHub CLI's login is kept the same way, in a volume of its own.
	"mounts": [
		"source=gmd-claude-home,target=/home/vscode/.claude,type=volume",
		"source=gmd-gh-config,target=/home/vscode/.config/gh,type=volume"
	],
	// The chowns are required, not defensive: Docker creates a named volume root-owned when the image
	// has no directory at the mount point, and the base image has no /home/vscode/.claude — so
	// without this the vscode user cannot write to its own Claude directory. The same goes for
	// .config/gh, and for .config itself should Docker have to make it for the mount.
	// The image ships the .NET 11 SDK that global.json pins, and its runtime, which the build and
	// the tests run on.
	"postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && sudo chown vscode:vscode /home/vscode/.config && sudo chown -R vscode:vscode /home/vscode/.config/gh && dotnet restore ./gmd/gmd.csproj && dotnet restore ./gmdTest/gmdTest.csproj && dotnet tool restore",
	// Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
	"remoteUser": "vscode"
}