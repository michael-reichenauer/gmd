#!/bin/bash
echo ""
echo "Update timezone to Europe/Stockholm"
sudo rm -rf /etc/localtime
sudo ln -s /usr/share/zoneinfo/Europe/Stockholm /etc/localtime
date

echo ""
echo "Updating apt ..."
sudo apt update -q -y
echo ""
echo "Installing mc ..."
sudo apt install -q mc -y 1>/dev/null
echo ""
echo "Installing lnav ..."
sudo apt install -q lnav -y 1>/dev/null
echo ""
echo "Installing xsel ..."
sudo apt install -q xsel -y 1>/dev/null

echo ""
echo "Installing tmux (drives the TUI in tests and for manual verification) ..."
sudo apt install -q tmux -y 1>/dev/null

echo ""
echo "Installing agg and its fonts (renders the demo animation, see ./demo) ..."
# Pinned, since a new version could render the same recording differently
AGG_VERSION="v1.9.0"
case "$(uname -m)" in
  arm64|aarch64) AGG_ASSET="agg-aarch64-unknown-linux-gnu" ;;
  *) AGG_ASSET="agg-x86_64-unknown-linux-gnu" ;;
esac
mkdir -p ~/.local/bin ~/.local/share/fonts
curl -fsSL -o ~/.local/bin/agg "https://github.com/asciinema/agg/releases/download/$AGG_VERSION/$AGG_ASSET"
chmod +x ~/.local/bin/agg
FONTS_TMP="$(mktemp -d)"
curl -fsSL -o "$FONTS_TMP/jetbrains.zip" "https://github.com/JetBrains/JetBrainsMono/releases/download/v2.304/JetBrainsMono-2.304.zip"
curl -fsSL -o "$FONTS_TMP/dejavu.zip" "https://github.com/dejavu-fonts/dejavu-fonts/releases/download/version_2_37/dejavu-fonts-ttf-2.37.zip"
unzip -q -o -j "$FONTS_TMP/jetbrains.zip" "fonts/ttf/JetBrainsMono-Regular.ttf" "fonts/ttf/JetBrainsMono-Bold.ttf" -d ~/.local/share/fonts
unzip -q -o -j "$FONTS_TMP/dejavu.zip" "dejavu-fonts-ttf-2.37/ttf/DejaVuSansMono.ttf" "dejavu-fonts-ttf-2.37/ttf/DejaVuSansMono-Bold.ttf" -d ~/.local/share/fonts
rm -rf "$FONTS_TMP"
~/.local/bin/agg --version

echo ""
echo "setting working folder as safe in git config ..."
git config --global --add safe.directory /workspaces/gmd

echo ""
echo "Ignoring bulk reformat commits in git blame ..."
git config blame.ignoreRevsFile .git-blame-ignore-revs

echo ""
echo "Adding dotnet tools to PATH ..."
if ! grep -qxF 'export PATH="$PATH:$HOME/.dotnet/tools"' ~/.profile; then
  echo 'export PATH="$PATH:$HOME/.dotnet/tools"' >> ~/.profile
fi

echo ""
echo "Install claude ..."
curl -fsSL https://claude.ai/install.sh | bash

echo ""
echo "Install gmd ..."
curl -sL https://raw.githubusercontent.com/michael-reichenauer/gmd/main/install.sh | bash

echo ""
echo "Installing the .NET 11 SDK side by side (global.json pins it, for the C# 15 compiler) ..."
curl -sSL https://dot.net/v1/dotnet-install.sh | sudo bash -s -- --channel 11.0 --quality preview --install-dir /usr/share/dotnet
dotnet --list-sdks

echo ""
echo "Restore dotnet local tools (CSharpier) ..."
dotnet tool restore

echo ""
echo "Install git post commit hook ..."
cp ./gmd/tools/post-commit-sample ./.git/hooks/post-commit
chmod +x ./.git/hooks/post-commit

echo ""
echo "Install git pre commit hook (CSharpier formatting) ..."
cp ./gmd/tools/pre-commit-sample ./.git/hooks/pre-commit
chmod +x ./.git/hooks/pre-commit

echo ""
echo "Done"

