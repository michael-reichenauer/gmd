#!/bin/bash

# Runs both test projects: gmdTest, the unit and real git tests, and gmdE2eTest, the end-to-end UI
# tests, which run in parallel (see gmdE2eTest/TestSetup.cs). Any arguments are passed on to
# 'dotnet test' and apply to both, e.g. to skip the tests that run real git:
#   ./test --filter "TestCategory!=Integration"
#
# '-tl:false' disables the MSBuild terminal logger, which the .NET 10 SDK turns on by default
# in an interactive terminal. It swallows the console test logger output entirely, so without
# this the run prints nothing at all when stdout is a terminal (but everything when piped).
dotnet test gmd.sln -tl:false -v quiet --nologo -l:"console;verbosity=normal" "$@"
