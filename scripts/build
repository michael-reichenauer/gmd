#!/bin/bash

# Runs at the repository root, wherever it is started from
cd "$(dirname "$0")/.." || exit 1

DOTNET="net10.0"

# The executables, and the package audit, go into artifacts/ (ignored by git)
OUT="artifacts"
mkdir -p "$OUT"

ISBUILDLINUX="$1" 


echo "Cleaning ..."
rm "$OUT/gmd.exe" 2>/dev/null
rm "$OUT/gmd_linux" 2>/dev/null
rm "$OUT/gmd_linux_x64" 2>/dev/null
rm "$OUT/gmd_linux_arm64" 2>/dev/null
rm "$OUT/gmd_osx" 2>/dev/null
rm "$OUT/gmd_osx_arm64" 2>/dev/null
rm "$OUT/gmd_windows" 2>/dev/null

if test -f "$OUT/gmd.exe"; then
    echo "Error: gmd.exe was not deleted!";
    exit -1;
fi
if test -f "$OUT/gmd_windows"; then
    echo "Error: gmd_windows was not deleted!";
    exit -1;
fi
if test -f "$OUT/gmd_linux"; then
    echo "Error: gmd_linux was not deleted!";
    exit -1;
fi
if test -f "$OUT/gmd_linux_x64"; then
    echo "Error: gmd_linux_x64 was not deleted!";
    exit -1;
fi
if test -f "$OUT/gmd_linux_arm64"; then
    echo "Error: gmd_linux_arm64 was not deleted!";
    exit -1;
fi
if test -f "$OUT/gmd_osx"; then
    echo "Error: gmd_osx was not deleted!";
    exit -1;
fi
if test -f "$OUT/gmd_osx_arm64"; then
    echo "Error: gmd_osx_arm64 was not deleted!";
    exit -1;
fi
echo ""
echo Run tests ...
# '-tl:false': the .NET 10 SDK terminal logger hides the console test logger output (see scripts/test)
# Both test projects, see scripts/test
dotnet test gmd.sln -tl:false -v quiet --nologo -l:"console;verbosity=normal"
if [ $? -ne 0 ]; then
  echo "Error: Tests failed"
  exit 1
fi

echo ""
echo "Checking for updates ..."
dotnet list package --outdated

echo ""
echo "Checking for deprecated ..."
dotnet list package --deprecated --include-transitive

echo ""
echo "Checking for vulnerabilities ..."
dotnet list package --vulnerable --include-transitive 2>&1 | tee "$OUT/build.log"
grep -q -i "critical\|high\|moderate" "$OUT/build.log"; [ $? -eq 0 ] && echo "Security Vulnerabilities found on the log output" 

echo ""
echo "Building linux ..."
dotnet publish gmd/gmd.csproj -c Release -r linux-x64 -p:PublishReadyToRun=true --self-contained true -p:PublishSingleFile=true
if [ $? -ne 0 ]; then
  echo "Error: linux-x64 publish failed"
  exit 1
fi
cp ./gmd/bin/Release/$DOTNET/linux-x64/publish/gmd "$OUT/gmd_linux_x64"

echo "Building linux (arm64) ..."
# Build Linux arm64 so it can run on Apple Silicon via a Linux environment
dotnet publish gmd/gmd.csproj -c Release -r linux-arm64 -p:PublishReadyToRun=true --self-contained true -p:PublishSingleFile=true
if [ $? -ne 0 ]; then
  echo "Error: linux-arm64 publish failed"
  exit 1
fi
cp ./gmd/bin/Release/$DOTNET/linux-arm64/publish/gmd "$OUT/gmd_linux_arm64"

if [[ $ISBUILDLINUX == "-l" ]] ; then
  echo "Built only linux."
  HOST_ARCH="$(uname -m)"
  case "${HOST_ARCH}" in
    x86_64|amd64) "$OUT/gmd_linux_x64" --version ;;
    arm64|aarch64) "$OUT/gmd_linux_arm64" --version ;;
    *) echo "Unknown arch (${HOST_ARCH}); skip version check." ;;
  esac 2>/dev/null
  exit 0
fi

echo "Building windows ..."
dotnet publish gmd/gmd.csproj -c Release -r win-x64 -p:PublishReadyToRun=true --self-contained true -p:PublishSingleFile=true
if [ $? -ne 0 ]; then
  echo "Error: win-x64 publish failed"
  exit 1
fi
cp ./gmd/bin/Release/$DOTNET/win-x64/publish/gmd.exe "$OUT/gmd_windows"
cp ./gmd/bin/Release/$DOTNET/win-x64/publish/gmd.exe "$OUT/gmd.exe"

echo "Building macOS (Apple Silicon) ..."
# Target Apple Silicon Macs (e.g. M4) with the arm64 RID
dotnet publish gmd/gmd.csproj -c Release -r osx-arm64 -p:PublishReadyToRun=true --self-contained true -p:PublishSingleFile=true
if [ $? -ne 0 ]; then
  echo "Error: osx-arm64 publish failed"
  exit 1
fi
cp ./gmd/bin/Release/$DOTNET/osx-arm64/publish/gmd "$OUT/gmd_osx_arm64"

echo ""
echo "Built version:"
HOST_OS="$(uname -s)"
HOST_ARCH="$(uname -m)"
case "${HOST_OS}_${HOST_ARCH}" in
  Darwin_*) "$OUT/gmd_osx_arm64" --version ;;
  Linux_x86_64|Linux_amd64) "$OUT/gmd_linux_x64" --version ;;
  Linux_arm64|Linux_aarch64) "$OUT/gmd_linux_arm64" --version ;;
  *) echo "Unknown host (${HOST_OS} ${HOST_ARCH}); skip version check." ;;
esac 2>/dev/null
