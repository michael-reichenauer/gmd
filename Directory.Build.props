<Project>
  <PropertyGroup>
    <!-- gmd/Utils/Result.cs is a custom union of C# 15, the language of net11.0, matched with 'switch'
         and 'is' on its case types. A switch over a result that does not handle both of its cases
         is a bug, not a warning -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>
</Project>
