<Project>
  <PropertyGroup>
    <!-- C# 15 (the .NET 11 SDK, pinned in global.json) for union types: gmd/Utils/Result.cs is a
         custom union, matched with 'switch' and 'is' on its case types. The target framework stays
         net10.0, so the union attribute is polyfilled in gmd/Utils/UnionPolyfill.cs. -->
    <LangVersion>15</LangVersion>
    <!-- A switch over a result that does not handle both of its cases is a bug, not a warning -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
  </PropertyGroup>
</Project>
