{
  "dotnet.defaultSolution": "gmd.sln",

  // CSharpier owns all C# formatting. It runs on save here, on build via the
  // CSharpier.MsBuild package, and on commit via the pre-commit hook.
  "editor.formatOnSave": true,
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },

  "cSpell.words": [
    "assertable",
    "Autofac",
    "Browsable",
    "cmds",
    "Collapseable",
    "Creater",
    "csharpier",
    "csharpierrc",
    "Dependitor",
    "devcontainers",
    "DISTRO",
    "dotnettools",
    "errorlevel",
    "findstr",
    "gmdconfig",
    "gmdstate",
    "headlessly",
    "Inno",
    "installtools",
    "libgit",
    "lnav",
    "mhutchie",
    "mstest",
    "nologo",
    "POLLIN",
    "pullable",
    "pushable",
    "setlocal",
    "softprops",
    "tmux",
    "Toplevel",
    "Uncommit",
    "Ungrab",
    "uninstallation",
    "unpulled",
    "unpushed",
    "Unresolve",
    "untestability",
    "updatechangelog",
    "updatepackages",
    "Upgrader",
    "ustring",
    "wakeup",
    "xclip",
    "xsel"
  ]
}
