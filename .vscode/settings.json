{
  "dotnet.defaultSolution": "gmd.sln",

  // CSharpier owns all C# formatting. It runs on save here, on build via the
  // CSharpier.MsBuild package, and on commit via the pre-commit hook.
  "editor.formatOnSave": true,
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode"
  },

  // The escape in a string literal is not part of the word after it. Without this, '"a\nbeta"'
  // is spell checked as 'nbeta' and '"\taddboth.txt"' as 'taddboth' — which is most of the
  // conflict tests, since their fixtures are files written out as one literal with the line
  // endings in them. Masking just the escape leaves the real word to be checked normally.
  "cSpell.ignoreRegExpList": ["\\\\[nrt]"],

  "cSpell.words": [
    "addboth",
    "assertable",
    "Autofac",
    "behavioural",
    "Browsable",
    "centred",
    "cmds",
    "Collapseable",
    "Creater",
    "csharpier",
    "csharpierrc",
    "defence",
    "Dependitor",
    "devcontainers",
    "DISTRO",
    "dotnettools",
    "errorlevel",
    "fffd",
    "findstr",
    "gitattributes",
    "gitdir",
    "gmdconfig",
    "gmds",
    "gmdstate",
    "gmdtags",
    "headlessly",
    "Inno",
    "installtools",
    "labelled",
    "libgit",
    "lnav",
    "mhutchie",
    "msgnum",
    "mstest",
    "nologo",
    "objectname",
    "offerable",
    "POLLIN",
    "pullable",
    "pushable",
    "recognised",
    "recognises",
    "refname",
    "refspec",
    "rerere",
    "retagged",
    "reterminate",
    "reterminated",
    "setlocal",
    "softprops",
    "stagedel",
    "stagemod",
    "submodule",
    "tmux",
    "Toplevel",
    "unapplied",
    "unchosen",
    "Uncommit",
    "Ungrab",
    "uninstallation",
    "unmerged",
    "unpulled",
    "unpushed",
    "Unresolve",
    "untestability",
    "updatechangelog",
    "updatepackages",
    "Upgrader",
    "ustring",
