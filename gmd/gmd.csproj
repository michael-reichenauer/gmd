<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ssZ"))</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />

    <!-- Formats sources on build (Debug) and fails the build if unformatted (Release).
         Set CSharpier_Bypass=true to skip. -->
    <PackageReference Include="CSharpier.MsBuild" Version="1.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the GC compact the large object heap when it fragments, where every read of the log puts
         its output, a string of megabytes: after a few refreshes of a log of 50,000 commits gmd held
         0.8 to 0.9 GB without, 0.6 GB with (level 7 of 9). The first refreshes after opening take
         up to a second longer while it compacts. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!-- Oniguruma (libonigwrap), the native library the grammars that color code in a diff run their
       regular expressions with (Cui/Common/CodeGrammars.cs), embedded for the platform built for, as a
       release is, which OnigurumaLibrary writes out and loads when it is not beside gmd. The single
       file leaves native libraries beside it, which a release is not shipped with, and bundled, the
       .NET host extracts them as gmd starts, and gmd does not start at all where it cannot. -->
  <Target Name="EmbedOniguruma" AfterTargets="ResolvePackageAssets" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <Oniguruma Include="@(NativeCopyLocalItems)" Condition="'%(Filename)' == 'libonigwrap'" />
      <EmbeddedResource Include="@(Oniguruma)" LogicalName="gmd.native.libonigwrap" />
    </ItemGroup>
    <Error
      Condition="'@(Oniguruma)' == ''"
      Text="No libonigwrap for $(RuntimeIdentifier) to embed, code would not be colored"
    />
  </Target>

  <ItemGroup>
    <!-- The spell check dictionary (SCOWL en_US, see doc/spelling/en_US.license). LogicalName pins the
         resource names rather than relying on how the folder path is mangled into one. -->
    <EmbeddedResource Include="doc/spelling/en_US.dic" LogicalName="gmd.doc.spelling.en_US.dic" />
    <EmbeddedResource Include="doc/spelling/en_US.aff" LogicalName="gmd.doc.spelling.en_US.aff" />
  </ItemGroup>
</Project>
